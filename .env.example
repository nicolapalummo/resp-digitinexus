# Copia questo file in .env e inserisci i valori reali. NON committare .env.
# Chiave per la generazione delle copertine blog (OpenAI Images, gpt-image-2).
OPENAI_API_KEY=sk-...

# Invio email risorse gratuite (/api/send-resources) — da impostare ANCHE su Vercel
# (Settings → Environment Variables). Resend: https://resend.com (dominio verificato).
RESEND_API_KEY=re_...
# Mittente (il dominio deve essere verificato su Resend)
RESOURCES_FROM_EMAIL="DigitiNexus <info@digitinexus.com>"
# Stringa casuale lunga per firmare i link di download a scadenza
RESOURCES_LINK_SECRET=
